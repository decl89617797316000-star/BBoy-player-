<Window x:Class="WindowsMiniPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Mini Player" Width="520" Height="235" WindowStyle="None"
 ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
 Background="#FF17191F" Foreground="#FFF3F5F8"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Border CornerRadius="12" BorderBrush="#FF343A46" BorderThickness="1" Padding="10">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" LastChildFill="True" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="—" Width="34" Click="Minimize_Click"/>
     <Button Content="×" Width="34" Click="Close_Click"/>
    </StackPanel>
    <TextBlock Text="WINDOWS MINI PLAYER" FontWeight="Bold" Foreground="#FF70B7FF" VerticalAlignment="Center" Margin="5"/>
    <TextBlock Text="  ·  RADIO / YOUTUBE / VK / MP3" Foreground="#FF9DA6B5" VerticalAlignment="Center" FontSize="10"/>
   </DockPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
    <Button Content="Радио" Click="RadioTab_Click"/>
    <Button Content="YouTube" Click="YouTube_Click"/>
    <Button Content="ВКонтакте" Click="Vk_Click"/>
    <Button Content="Моя музыка" Click="MusicTab_Click"/>
   </StackPanel>
   <Grid Grid.Row="2">
    <Grid x:Name="RadioView">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel>
      <Button Content="Найти" DockPanel.Dock="Right" Click="SearchRadio_Click"/>
      <TextBox x:Name="RadioSearch" Text="rock" />
     </DockPanel>
     <ListBox x:Name="Stations" Grid.Row="1" Background="#FF242832" Foreground="#FFF3F5F8"
      BorderThickness="0" SelectionChanged="Stations_SelectionChanged" DisplayMemberPath="Name"/>
    </Grid>
    <Grid x:Name="MusicView" Visibility="Collapsed">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
       <Button Content="Добавить файлы" Click="AddFiles_Click"/>
       <Button Content="Папка музыки" Click="OpenMusicFolder_Click"/>
      </StackPanel>
      <ListBox x:Name="Tracks" Background="#FF242832" Foreground="#FFF3F5F8" BorderThickness="0"
       SelectionChanged="Tracks_SelectionChanged" DisplayMemberPath="Name"/>
     </DockPanel>
    </Grid>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,7,0,0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="Остановить" Click="Stop_Click"/>
     <Button Content="Скачать разрешённый файл" Click="Download_Click"/>
    </StackPanel>
    <StackPanel>
     <TextBlock x:Name="NowPlaying" Text="Выбери радиостанцию или MP3" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="Status" Text="Готово" Foreground="#FF9DA6B5" FontSize="10"/>
    </StackPanel>
   </DockPanel>
  </Grid>
 </Border>
</Window>
