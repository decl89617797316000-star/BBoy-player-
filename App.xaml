<Application x:Class="WindowsMiniPlayer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#FF17191F"/>
  <SolidColorBrush x:Key="Panel2" Color="#FF242832"/>
  <SolidColorBrush x:Key="Accent" Color="#FF70B7FF"/>
  <SolidColorBrush x:Key="TextMain" Color="#FFF3F5F8"/>
  <SolidColorBrush x:Key="TextDim" Color="#FF9DA6B5"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="{StaticResource Panel2}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="{StaticResource Panel2}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Margin" Value="3"/>
  </Style>
 </Application.Resources>
</Application>
